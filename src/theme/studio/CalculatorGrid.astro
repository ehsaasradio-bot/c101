---
import type { CalculatorGridProps } from '../contract'

type Props = CalculatorGridProps
const { items } = Astro.props
---

<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((item, i) => (
      <li>
        <a
          href={item.href}
          data-cat={i % 5}
          class="group flex h-full flex-col rounded-card border border-border-subtle bg-surface p-5 transition-colors hover:border-accent"
        >
          <span
            class="grid size-9 place-items-center rounded-control text-sm font-semibold"
            style="background: color-mix(in oklch, var(--cat) 16%, transparent); color: var(--cat)"
            aria-hidden="true"
          >
            {item.title.charAt(0)}
          </span>
          <span class="mt-3 text-sm font-medium text-ink group-hover:text-accent">{item.title}</span>
          <span class="mt-1 text-xs leading-relaxed text-ink-muted">{item.description}</span>
        </a>
      </li>
    ))
  }
</ul>
