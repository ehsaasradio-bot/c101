---
import type { QuickyProps } from '../contract'
import { defaultValues } from '../../lib/view'

type Props = QuickyProps
const { rows } = Astro.props

const cell =
  'w-full bg-transparent px-3 py-2.5 text-sm tabular-nums text-ink outline-none ' +
  'focus:bg-accent-soft aria-[invalid=true]:text-[var(--c-band-critical)]'
---

{
  rows.length > 0 && (
    <section id="quicky" class="mt-14 scroll-mt-24">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-xl font-semibold tracking-tight text-ink">Quicky</h2>
        <p class="text-sm text-ink-muted">Type across the row — the green cell answers as you go</p>
      </div>

      <div class="mt-4 space-y-4">
        {rows.map((row) => {
          const values = defaultValues(row.calc)
          // Only fields that fit a single cell. A free-text or date field would
          // break the row; numbers, selects and toggles all sit in one happily.
          const cells = row.calc.fields.filter(
            (f) => f.kind === 'number' || f.kind === 'select' || f.kind === 'toggle',
          )
          return (
            <calc-form data-slug={row.calc.slug} class="block">
              <script
                is:inline
                type="application/json"
                data-calc-config
                set:html={JSON.stringify(row.calc)}
              />

              <div class="overflow-hidden rounded-card border border-border-subtle bg-surface">
                <div class="flex items-center justify-between gap-3 border-b border-border-subtle px-4 py-2.5">
                  <span class="text-sm font-medium text-ink">{row.title}</span>
                  <a href={row.href} class="text-xs text-ink-muted hover:text-accent">
                    Open full calculator →
                  </a>
                </div>

                {/* Horizontal scroll rather than wrapping: a spreadsheet row
                    that wraps stops reading as a row. */}
                <div class="overflow-x-auto">
                  <table class="w-full min-w-[44rem] border-collapse text-left">
                    <thead>
                      <tr class="bg-surface-sunken">
                        {cells.map((field) => (
                          <th
                            scope="col"
                            class="border-r border-border-subtle px-3 py-2 text-[11px] font-medium uppercase tracking-wide text-ink-muted"
                          >
                            {field.label}
                          </th>
                        ))}
                        <th
                          scope="col"
                          class="px-3 py-2 text-[11px] font-medium uppercase tracking-wide text-ink-muted"
                        >
                          {row.calc.resultLabel}
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        {cells.map((field) => (
                          <td class="border-r border-t border-border-subtle p-0 align-middle">
                            {field.kind === 'select' ? (
                              <select data-calc-field={field.id} class={cell}>
                                {field.options.map((option) => (
                                  <option
                                    value={option.value}
                                    selected={option.value === String(values[field.id])}
                                  >
                                    {option.label}
                                  </option>
                                ))}
                              </select>
                            ) : field.kind === 'toggle' ? (
                              <span class="flex items-center px-3 py-2.5">
                                <input
                                  data-calc-field={field.id}
                                  type="checkbox"
                                  checked={Boolean(values[field.id])}
                                  aria-label={field.label}
                                  class="size-4 accent-[var(--c-accent)]"
                                />
                              </span>
                            ) : (
                              <input
                                data-calc-field={field.id}
                                type="number"
                                value={String(values[field.id] ?? '')}
                                min={field.min}
                                max={field.max}
                                step={field.step}
                                inputmode="decimal"
                                autocomplete="off"
                                aria-label={field.label}
                                class={cell}
                              />
                            )}
                          </td>
                        ))}

                        {/* The answer cell. Green because it is the one the
                            spreadsheet fills in for you. */}
                        <td
                          data-calc-result
                          class="border-t border-border-subtle px-3 py-2.5 align-middle"
                          style="background: color-mix(in oklch, var(--c-band-excellent) 22%, transparent)"
                        >
                          <span
                            data-calc-out="primary"
                            data-animate="count"
                            class="text-sm font-semibold tabular-nums text-ink"
                          >
                            {row.initial.primary.text}
                          </span>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <p
                  data-calc-error
                  hidden
                  role="alert"
                  class="border-t border-border-subtle px-4 py-2 text-xs"
                  style="color: var(--c-band-critical)"
                />
              </div>
            </calc-form>
          )
        })}
      </div>
    </section>
  )
}
