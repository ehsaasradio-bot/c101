---
import type { QuickyProps } from '../contract'
import { defaultValues } from '../../lib/view'

type Props = QuickyProps
const { groups } = Astro.props

const cell =
  'w-full bg-transparent px-3 py-2.5 text-sm tabular-nums text-ink outline-none ' +
  'focus:bg-accent-soft aria-[invalid=true]:text-[var(--c-band-critical)]'

const total = groups.reduce((n, g) => n + g.rows.length, 0)
---

{
  total > 0 && (
    <section id="quicky" class="mt-14 scroll-mt-24">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-xl font-semibold tracking-tight text-ink">Quicky</h2>
        <p class="text-sm text-ink-muted">
          All {total} calculators as one-line rows — type across, the green cell answers
        </p>
      </div>

      {groups.map((group) => (
        <div class="mt-8">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-muted">
            <a href={group.href} class="hover:text-accent">
              {group.name}
            </a>
          </h3>

          <div class="mt-3 space-y-3">
            {group.rows.map((row) => {
              const values = defaultValues(row.calc)
              return (
                <calc-form data-slug={row.calc.slug} class="block">
                  {/* Only what the island reads — see IslandConfig. Shipping the
                      full view here would cost ~3.4 KB per row. */}
                  <script
                    is:inline
                    type="application/json"
                    data-calc-config
                    set:html={JSON.stringify({ fields: row.calc.fields, scale: row.calc.scale })}
                  />

                  <div class="overflow-hidden rounded-card border border-border-subtle bg-surface">
                    <div class="flex items-center justify-between gap-3 border-b border-border-subtle px-4 py-2">
                      <span class="text-sm font-medium text-ink">{row.title}</span>
                      <a href={row.href} class="shrink-0 text-xs text-ink-muted hover:text-accent">
                        Open →
                      </a>
                    </div>

                    {/* Scrolls rather than wraps: a spreadsheet row that wraps
                        stops reading as a row. */}
                    <div class="overflow-x-auto">
                      <table class="w-full min-w-[42rem] border-collapse text-left">
                        <thead>
                          <tr class="bg-surface-sunken">
                            {row.calc.fields.map((field) => (
                              <th
                                scope="col"
                                class="border-r border-border-subtle px-3 py-1.5 text-[10px] font-medium uppercase tracking-wide text-ink-muted"
                              >
                                {field.label}
                              </th>
                            ))}
                            <th
                              scope="col"
                              class="px-3 py-1.5 text-[10px] font-medium uppercase tracking-wide text-ink-muted"
                            >
                              {row.calc.resultLabel}
                            </th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr>
                            {row.calc.fields.map((field) => (
                              <td class="border-r border-t border-border-subtle p-0 align-middle">
                                {field.kind === 'select' ? (
                                  <select data-calc-field={field.id} class={cell}>
                                    {field.options.map((option) => (
                                      <option
                                        value={option.value}
                                        selected={option.value === String(values[field.id])}
                                      >
                                        {option.label}
                                      </option>
                                    ))}
                                  </select>
                                ) : field.kind === 'toggle' ? (
                                  <span class="flex items-center px-3 py-2.5">
                                    <input
                                      data-calc-field={field.id}
                                      type="checkbox"
                                      checked={Boolean(values[field.id])}
                                      aria-label={field.label}
                                      class="size-4 accent-[var(--c-accent)]"
                                    />
                                  </span>
                                ) : (
                                  <input
                                    data-calc-field={field.id}
                                    type={
                                      field.kind === 'number'
                                        ? 'number'
                                        : field.kind === 'date'
                                          ? 'date'
                                          : 'text'
                                    }
                                    value={String(values[field.id] ?? '')}
                                    min={field.kind === 'number' ? field.min : undefined}
                                    max={field.kind === 'number' ? field.max : undefined}
                                    step={field.kind === 'number' ? field.step : undefined}
                                    inputmode={field.kind === 'number' ? 'decimal' : undefined}
                                    autocomplete="off"
                                    aria-label={field.label}
                                    class={cell}
                                  />
                                )}
                              </td>
                            ))}

                            {/* The answer cell — green because it is the one the
                                spreadsheet fills in for you. */}
                            <td
                              data-calc-result
                              class="border-t border-border-subtle px-3 py-2.5 align-middle"
                              style="background: color-mix(in oklch, var(--c-band-excellent) 22%, transparent)"
                            >
                              <span
                                data-calc-out="primary"
                                data-animate="count"
                                class="whitespace-nowrap text-sm font-semibold tabular-nums text-ink"
                              >
                                {row.initial.primary.text}
                              </span>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>

                    <p
                      data-calc-error
                      hidden
                      role="alert"
                      class="border-t border-border-subtle px-4 py-2 text-xs"
                      style="color: var(--c-band-critical)"
                    />
                  </div>
                </calc-form>
              )
            })}
          </div>
        </div>
      ))}
    </section>
  )
}
