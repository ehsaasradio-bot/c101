---
import type { CalculatorPageProps } from '../contract'
import FieldGroup from './FieldGroup.astro'
import SummaryCard from './SummaryCard.astro'
import TimeChart from './TimeChart.astro'
import FaqList from './FaqList.astro'
import RelatedGrid from './RelatedGrid.astro'
import { defaultValues } from '../../lib/view'

type Props = CalculatorPageProps
const { calc, initial, disclaimer, scenarios = [], heroCurve = null } = Astro.props

const values = defaultValues(calc)
const badges = ['Accurate', 'Real-time', 'Easy to use', '100% free']

// The two figures floated over the hero art. Taken from whatever the calculator
// already returns, so this works for every calculator, not just this one.
const heroPoints = heroCurve?.points ?? null

// Scale into the 320x170 viewBox. The y range is padded so a flat line sits in
// the middle rather than along the floor, and a constant result does not divide
// by zero.
const HERO = { w: 320, h: 170, pad: { x: 8, top: 14, bottom: 12 } }
const heroPath = (() => {
  if (!heroPoints) return null
  const xs = heroPoints.map((p) => p[0])
  const ys = heroPoints.map((p) => p[1])
  const xMin = Math.min(...xs)
  const xMax = Math.max(...xs)
  const yMin = Math.min(...ys)
  const yMax = Math.max(...ys)
  const ySpan = yMax - yMin || Math.abs(yMax) || 1
  const sx = (x: number) =>
    HERO.pad.x + ((x - xMin) / (xMax - xMin || 1)) * (HERO.w - HERO.pad.x * 2)
  const sy = (y: number) =>
    HERO.h - HERO.pad.bottom - ((y - yMin) / ySpan) * (HERO.h - HERO.pad.top - HERO.pad.bottom)

  const d = heroPoints
    .map((p, i) => `${i === 0 ? 'M' : 'L'}${sx(p[0]).toFixed(1)} ${sy(p[1]).toFixed(1)}`)
    .join(' ')
  const first = heroPoints[0]!
  const last = heroPoints[heroPoints.length - 1]!
  const area = `${d} L${sx(last[0]).toFixed(1)} ${HERO.h - HERO.pad.bottom} L${sx(first[0]).toFixed(1)} ${HERO.h - HERO.pad.bottom} Z`

  // Five markers, evenly spaced along the real points.
  const dots = Array.from({ length: 5 }, (_, i) => {
    const point = heroPoints[Math.round((i * (heroPoints.length - 1)) / 4)]!
    return { cx: sx(point[0]).toFixed(1), cy: sy(point[1]).toFixed(1) }
  })
  return { d, area, dots }
})()

const highlights = [
  { label: initial.primary.label, text: initial.primary.text },
  initial.stats[1] ?? initial.stats[0],
].filter(Boolean)
---

<article>
  <header class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -right-32 -top-40 size-[34rem] rounded-full opacity-60 blur-3xl"
      style="background: radial-gradient(circle, color-mix(in oklch, var(--c-accent) 22%, transparent), transparent 70%)"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-4 pb-10 pt-8 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div>
        <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">{calc.title}</h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-muted">{calc.intro}</p>

        <ul class="mt-6 flex flex-wrap gap-2">
          {
            badges.map((badge, i) => (
              <li
                data-cat={i % 5}
                class="inline-flex items-center gap-1.5 rounded-full border border-border-subtle bg-surface px-3 py-1.5 text-xs font-medium text-ink"
              >
                <span class="size-1.5 rounded-full" style="background: var(--cat)" />
                {badge}
              </li>
            ))
          }
        </ul>
      </div>

      {/* Hero art: the calculator's own numbers, or nothing. Where there is no
          numeric curve the panel keeps its height so the value cards still have
          corners to sit in — an empty panel is honest, a fake curve is not. */}
      <div class="relative">
        <div class="rounded-card border border-border-subtle bg-surface p-6">
          {
            heroPath ? (
              <svg
                viewBox={`0 0 ${HERO.w} ${HERO.h}`}
                class="w-full"
                role="img"
                aria-label={heroCurve?.label ?? ''}
              >
                <defs>
                  <linearGradient id="heroFade" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--c-cat-1)" stop-opacity="0.28" />
                    <stop offset="100%" stop-color="var(--c-cat-1)" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <path d={heroPath.area} fill="url(#heroFade)" />
                <path
                  d={heroPath.d}
                  fill="none"
                  stroke="var(--c-cat-1)"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                {heroPath.dots.map((dot) => (
                  <circle
                    cx={dot.cx}
                    cy={dot.cy}
                    r="4"
                    fill="var(--c-surface)"
                    stroke="var(--c-cat-1)"
                    stroke-width="2.5"
                  />
                ))}
              </svg>
            ) : (
              <div class="h-[170px]" aria-hidden="true" />
            )
          }
        </div>

        {
          highlights.map((h, i) => (
            <div
              data-hero-highlight={i}
              class:list={[
                // Translucent, because the curve is now real data rather than ornament.
                // The old decorative path always rose, so cards in the top-left and
                // bottom-right corners sat in empty space; a real curve often falls —
                // a loan balance, a remaining term — straight along that diagonal, and
                // an opaque card would hide the endpoints it is labelling.
                'absolute w-44 rounded-card border border-border-subtle bg-surface/80 p-3 shadow-sm backdrop-blur-sm',
                i === 0 ? '-left-2 top-4 sm:-left-6' : '-right-2 bottom-4 sm:-right-6',
              ]}
            >
              {/* The marker is on the card, not the number, so the script can
                  rewrite both halves. A converter's card reads "Cost per km" one
                  keystroke and "Cost per mile" the next; updating only the figure
                  leaves a correct number under a wrong name, which is a harder
                  error to notice than a stale one. */}
              <p data-slot="label" class="truncate text-[11px] text-ink-muted">{h!.label}</p>
              <p data-slot="value" class="mt-0.5 text-lg font-semibold tabular-nums text-ink">
                {h!.text}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-6xl px-4">
    {/*
      min-w-0 on both cards, or the page scrolls sideways on a phone. A grid
      item defaults to min-width:auto, so it refuses to shrink below its
      content's min-content width — and an <input> carries a large intrinsic
      width, which pushed this single-column track to 484px inside a 343px
      viewport. It only shows below `lg`, where the two columns stack.
    */}
    <div class="grid gap-6 lg:grid-cols-[1fr_1.05fr] lg:items-start">
      <section
        class="min-w-0 rounded-card border border-border-subtle bg-surface p-6"
        aria-label="Inputs"
      >
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-sm font-semibold text-ink">Details</h2>
          <span class="flex items-center gap-1.5 text-xs text-ink-muted">
            <span class="size-1.5 rounded-full" style="background: var(--c-cat-5)"></span>
            Updates as you type
          </span>
        </div>
        <div class="mt-5">
          <FieldGroup fields={calc.fields} values={values} />
        </div>
      </section>

      <SummaryCard result={initial} resultLabel={calc.resultLabel} scale={calc.scale} />
    </div>

    {
      initial.series.length > 0 && (
        <div class="mt-6">
          <TimeChart series={initial.series} chart={initial.chart} />
        </div>
      )
    }

    {
      scenarios.length > 0 && (
        <section class="mt-6" aria-label="Compare scenarios">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="text-xl font-semibold tracking-tight text-ink">Compare scenarios</h2>
            <p class="text-sm text-ink-muted">See how one change moves the result</p>
          </div>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {scenarios.map((scenario) => (
              <li
                class:list={[
                  'flex h-full flex-col rounded-card border bg-surface p-4',
                  scenario.current ? 'border-accent' : 'border-border-subtle',
                ]}
              >
                <span class="flex items-center gap-2 text-sm font-medium text-ink">
                  <span
                    class:list={[
                      'grid size-4 place-items-center rounded-full border',
                      scenario.current ? 'border-accent bg-accent' : 'border-border-subtle',
                    ]}
                    aria-hidden="true"
                  >
                    {scenario.current && <span class="size-1.5 rounded-full bg-[var(--c-accent-ink)]" />}
                  </span>
                  {scenario.label}
                </span>
                <span class="mt-1 text-xs text-ink-muted">{scenario.detail}</span>
                {/* The "current" card states what the inputs give right now, so
                    it has to follow them; the presets are fixed by definition. */}
                <span
                  class="mt-3 text-xl font-semibold tabular-nums text-ink"
                  data-scenario-live={scenario.current ? '' : undefined}
                >
                  {scenario.primaryText}
                </span>
                <span class="mt-auto pt-3">
                  {scenario.current ? (
                    <span class="block rounded-control bg-surface-sunken px-3 py-1.5 text-center text-xs font-medium text-ink-muted">
                      Current
                    </span>
                  ) : (
                    <button
                      type="button"
                      data-scenario={JSON.stringify(scenario.values)}
                      class="w-full rounded-control border border-border-subtle px-3 py-1.5 text-xs font-medium text-ink transition-colors hover:border-accent hover:text-accent"
                    >
                      Use scenario
                    </button>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {disclaimer && <p class="mt-6 text-xs text-ink-muted">{disclaimer}</p>}

    <FaqList faqs={calc.faqs} />
    <RelatedGrid links={calc.relatedLinks} />
  </div>
</article>
