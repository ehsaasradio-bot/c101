---
import type { FaqListProps } from '../contract'

type Props = FaqListProps
const { faqs } = Astro.props
---

{
  faqs.length > 0 && (
    <section class="mt-10">
      <h2 class="text-xl font-semibold tracking-tight text-ink">Frequently asked questions</h2>
      <div class="mt-4 grid gap-3 lg:grid-cols-2">
        {faqs.map((faq) => (
          <details class="group rounded-card border border-border-subtle bg-surface px-5 py-4">
            <summary class="flex cursor-pointer items-start justify-between gap-4 text-sm font-medium text-ink">
              {faq.q}
              <span
                class="mt-0.5 shrink-0 text-ink-muted transition-transform group-open:rotate-180"
                aria-hidden="true"
              >
                ⌄
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
