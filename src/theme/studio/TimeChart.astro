---
import type { ChartCopy, Series } from '../../lib/types'
import { chartScale, compactTick, projector, xTickValues, yTickValues } from './axis'

interface Props {
  series: ReadonlyArray<Series>
  chart?: ChartCopy
}

// The fallbacks are this theme's wording, not the calculator's, which is why
// they live here and not in lib/. They read correctly for a balance over years
// — the case that was hardcoded — and any calculator plotting something else
// names its own via `chart` on the result.
const CAPTION_FALLBACK = 'Balance over time'
const X_LABEL_FALLBACK = 'Years'

const { series, chart = {} } = Astro.props
const caption = chart.title ?? CAPTION_FALLBACK
const xLabel = chart.xLabel ?? X_LABEL_FALLBACK

// Geometry is computed here and recomputed by studio.ts on every recompute.
// Keeping both in the theme is the point: the island never learns what a chart
// is. The maths itself lives in ./axis.ts so the two passes cannot diverge.
const W = 720
const H = 260
const PAD = { top: 16, right: 16, bottom: 28, left: 56 }

const scale = chartScale(series)
const { xMin, xMax, yMin, yMax } = scale
const { x: sx, y: sy } = projector({ W, H, PAD }, scale)

const path = (s: Series) =>
  s.points.map((p, i) => `${i === 0 ? 'M' : 'L'}${sx(p[0]).toFixed(1)} ${sy(p[1]).toFixed(1)}`).join(' ')

const area = (s: Series) =>
  `${path(s)} L${sx(s.points[s.points.length - 1]![0]).toFixed(1)} ${H - PAD.bottom} L${sx(s.points[0]![0]).toFixed(1)} ${H - PAD.bottom} Z`

const yTicks = yTickValues(yMin, yMax)
const xTicks = xTickValues(xMin, xMax)
const ySpan = yMax - yMin
---

<figure
  data-studio-chart
  data-chart-geometry={JSON.stringify({ W, H, PAD })}
  class="rounded-card border border-border-subtle bg-surface p-5"
>
  <figcaption class="flex flex-wrap items-center justify-between gap-3">
    <span data-chart-caption class="text-sm font-semibold text-ink">{caption}</span>
    <span data-chart-legend class="flex items-center gap-4 text-xs text-ink-muted">
      {
        series.map((s, i) => (
          <span data-cat={i % 5} class="flex items-center gap-1.5">
            <span class="h-0.5 w-4 rounded-full" style="background: var(--cat)" />
            <span data-slot="label">{s.label}</span>
          </span>
        ))
      }
    </span>
  </figcaption>

  {/* The accessible name follows the caption. It was the third copy of the
      hardcoded string, and the one nobody would have noticed was wrong. */}
  <svg
    data-chart-figure
    viewBox={`0 0 ${W} ${H}`}
    class="mt-4 w-full"
    role="img"
    aria-label={caption}
  >
    {/* Gridlines never move — a tick's y is a fixed fraction of the plot height,
        because the yMax in the tick value cancels against the yMax in the
        projection — so they are drawn once and left alone. The labels beside
        them are a different matter: those scale with the data. */}
    {
      yTicks.map((t) => (
        <line
          x1={PAD.left}
          x2={W - PAD.right}
          y1={sy(t)}
          y2={sy(t)}
          stroke="var(--c-border)"
          stroke-width="1"
        />
      ))
    }
    <g data-chart-yticks>
      {
        yTicks.map((t) => (
          <text x={PAD.left - 8} y={sy(t) + 4} text-anchor="end" font-size="11" fill="var(--c-ink-muted)">
            {compactTick(t, ySpan)}
          </text>
        ))
      }
    </g>
    {/* The x labels are a varying-count set: a three-year horizon wants four
        ticks and a hundred-year one six, so studio.ts reconciles them against a
        template rather than assuming the build-time arity. */}
    <g data-chart-xticks>
      {
        xTicks.map((t) => (
          <text x={sx(t)} y={H - 8} text-anchor="middle" font-size="11" fill="var(--c-ink-muted)">
            {Math.round(t)}
          </text>
        ))
      }
    </g>

    {/* Series live in their own <g> so studio.ts can reconcile the whole set
        against a count that changed: an inflation chart has two lines, and none
        at all once you ask for zero years. */}
    <g data-chart-series>
      {
        series.map((s, i) => (
          <g data-cat={i % 5}>
            {i === 0 && (
              <path
                data-slot="area"
                d={area(s)}
                fill="var(--cat)"
                opacity="0.10"
                style="transition: d var(--motion-med) var(--ease)"
              />
            )}
            <path
              data-slot="line"
              d={path(s)}
              fill="none"
              stroke="var(--cat)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="transition: d var(--motion-med) var(--ease)"
            />
          </g>
        ))
      }
    </g>
  </svg>
  <p data-chart-xlabel class="mt-1 text-center text-xs text-ink-muted">{xLabel}</p>

  {/* Cloned by studio.ts, exactly as the island clones [data-calc-row]. Two row
      kinds rather than a flag, so "the first line is the filled one" stays a
      decision of this file — the script only picks a prototype by index, the
      way the island picks between a step row and a rule. The throwaway <svg>
      wrapper puts the parser in foreign-content mode; a bare <path> inside a
      <template> is an unknown HTML element and never paints. */}
  <template data-chart-row="series-filled">
    <svg>
      <g>
        <path
          data-slot="area"
          fill="var(--cat)"
          opacity="0.10"
          style="transition: d var(--motion-med) var(--ease)"
        ></path>
        <path
          data-slot="line"
          fill="none"
          stroke="var(--cat)"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="transition: d var(--motion-med) var(--ease)"
        ></path>
      </g>
    </svg>
  </template>

  <template data-chart-row="series">
    <svg>
      <g>
        <path
          data-slot="line"
          fill="none"
          stroke="var(--cat)"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="transition: d var(--motion-med) var(--ease)"
        ></path>
      </g>
    </svg>
  </template>

  <template data-chart-row="legend">
    <span class="flex items-center gap-1.5">
      <span class="h-0.5 w-4 rounded-full" style="background: var(--cat)"></span>
      <span data-slot="label"></span>
    </span>
  </template>

  {/* Axis labels. Position is set by the script because it depends on the scale;
      everything about how they look stays here. */}
  <template data-chart-row="ytick">
    <svg>
      <text text-anchor="end" font-size="11" fill="var(--c-ink-muted)"></text>
    </svg>
  </template>

  <template data-chart-row="xtick">
    <svg>
      <text text-anchor="middle" font-size="11" fill="var(--c-ink-muted)"></text>
    </svg>
  </template>
</figure>
