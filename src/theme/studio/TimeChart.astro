---
import type { Series } from '../../lib/types'
import { formatValue } from '../../lib/format'

interface Props {
  series: ReadonlyArray<Series>
  xLabel?: string
}

const { series, xLabel = 'Years' } = Astro.props

// Geometry is computed here and recomputed by studio.ts on every recompute.
// Keeping both in the theme is the point: the island never learns what a chart is.
const W = 720
const H = 260
const PAD = { top: 16, right: 16, bottom: 28, left: 56 }

const xs = series.flatMap((s) => s.points.map((p) => p[0]))
const ys = series.flatMap((s) => s.points.map((p) => p[1]))
const xMin = Math.min(...xs)
const xMax = Math.max(...xs)
const yMax = Math.max(...ys) * 1.05

const sx = (x: number) =>
  PAD.left + ((x - xMin) / (xMax - xMin || 1)) * (W - PAD.left - PAD.right)
const sy = (y: number) => H - PAD.bottom - (y / (yMax || 1)) * (H - PAD.top - PAD.bottom)

const path = (s: Series) =>
  s.points.map((p, i) => `${i === 0 ? 'M' : 'L'}${sx(p[0]).toFixed(1)} ${sy(p[1]).toFixed(1)}`).join(' ')

const area = (s: Series) =>
  `${path(s)} L${sx(s.points[s.points.length - 1]![0]).toFixed(1)} ${H - PAD.bottom} L${sx(s.points[0]![0]).toFixed(1)} ${H - PAD.bottom} Z`

const yTicks = Array.from({ length: 5 }, (_, i) => (yMax / 4) * i)
const xTickCount = Math.min(6, xMax - xMin + 1)
const xTicks = Array.from(
  { length: xTickCount },
  (_, i) => xMin + ((xMax - xMin) * i) / (xTickCount - 1 || 1),
)
const compact = (v: number) =>
  Math.abs(v) >= 1_000_000
    ? `${Math.round(v / 100_000) / 10}M`
    : Math.abs(v) >= 1000
      ? `${Math.round(v / 100) / 10}k`
      : formatValue(v, { style: 'decimal', decimals: 0 })
---

<figure
  data-studio-chart
  data-chart-geometry={JSON.stringify({ W, H, PAD })}
  class="rounded-card border border-border-subtle bg-surface p-5"
>
  <figcaption class="flex flex-wrap items-center justify-between gap-3">
    <span class="text-sm font-semibold text-ink">Balance over time</span>
    <span data-chart-legend class="flex items-center gap-4 text-xs text-ink-muted">
      {
        series.map((s, i) => (
          <span data-cat={i % 5} class="flex items-center gap-1.5">
            <span class="h-0.5 w-4 rounded-full" style="background: var(--cat)" />
            <span data-slot="label">{s.label}</span>
          </span>
        ))
      }
    </span>
  </figcaption>

  <svg viewBox={`0 0 ${W} ${H}`} class="mt-4 w-full" role="img" aria-label="Balance over time">
    {
      yTicks.map((t) => (
        <>
          <line
            x1={PAD.left}
            x2={W - PAD.right}
            y1={sy(t)}
            y2={sy(t)}
            stroke="var(--c-border)"
            stroke-width="1"
          />
          <text x={PAD.left - 8} y={sy(t) + 4} text-anchor="end" font-size="11" fill="var(--c-ink-muted)">
            {compact(t)}
          </text>
        </>
      ))
    }
    {
      xTicks.map((t) => (
        <text x={sx(t)} y={H - 8} text-anchor="middle" font-size="11" fill="var(--c-ink-muted)">
          {Math.round(t)}
        </text>
      ))
    }

    {/* Series live in their own <g> so studio.ts can reconcile the whole set
        against a count that changed: an inflation chart has two lines, and none
        at all once you ask for zero years. */}
    <g data-chart-series>
      {
        series.map((s, i) => (
          <g data-cat={i % 5}>
            {i === 0 && (
              <path
                data-slot="area"
                d={area(s)}
                fill="var(--cat)"
                opacity="0.10"
                style="transition: d var(--motion-med) var(--ease)"
              />
            )}
            <path
              data-slot="line"
              d={path(s)}
              fill="none"
              stroke="var(--cat)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="transition: d var(--motion-med) var(--ease)"
            />
          </g>
        ))
      }
    </g>
  </svg>
  <p class="mt-1 text-center text-xs text-ink-muted">{xLabel}</p>

  {/* Cloned by studio.ts, exactly as the island clones [data-calc-row]. Two row
      kinds rather than a flag, so "the first line is the filled one" stays a
      decision of this file — the script only picks a prototype by index, the
      way the island picks between a step row and a rule. The throwaway <svg>
      wrapper puts the parser in foreign-content mode; a bare <path> inside a
      <template> is an unknown HTML element and never paints. */}
  <template data-chart-row="series-filled">
    <svg>
      <g>
        <path
          data-slot="area"
          fill="var(--cat)"
          opacity="0.10"
          style="transition: d var(--motion-med) var(--ease)"
        ></path>
        <path
          data-slot="line"
          fill="none"
          stroke="var(--cat)"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="transition: d var(--motion-med) var(--ease)"
        ></path>
      </g>
    </svg>
  </template>

  <template data-chart-row="series">
    <svg>
      <g>
        <path
          data-slot="line"
          fill="none"
          stroke="var(--cat)"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="transition: d var(--motion-med) var(--ease)"
        ></path>
      </g>
    </svg>
  </template>

  <template data-chart-row="legend">
    <span class="flex items-center gap-1.5">
      <span class="h-0.5 w-4 rounded-full" style="background: var(--cat)"></span>
      <span data-slot="label"></span>
    </span>
  </template>
</figure>
