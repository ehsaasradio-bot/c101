---
import type { ShellProps } from '../contract'
import Breadcrumbs from './Breadcrumbs.astro'
import Logo from './Logo.astro'
import { SITE_NAME } from '../../lib/site'
import { categories } from '../../lib/categories'

type Props = ShellProps
const { breadcrumbs } = Astro.props
---

<div class="min-h-screen flex flex-col">
  <header class="sticky top-0 z-30 bg-surface/90 backdrop-blur border-b border-border-subtle">
    <div class="mx-auto max-w-6xl px-4 h-16 flex items-center gap-8">
      {/* The mark is a wordmark — it spells the name, so a text label beside it
          would say the same thing twice. The accessible name comes from the
          link, which is what a screen reader announces either way. */}
      <a href="/" class="flex items-center shrink-0" aria-label={`${SITE_NAME} — home`}>
        <Logo height={26} />
      </a>

      <nav aria-label="Categories" class="hidden md:flex items-center gap-6 text-sm">
        {
          categories.map((category) => (
            <a href={`${category.href}/`} class="text-ink-muted hover:text-accent transition-colors">
              {category.name}
            </a>
          ))
        }
        <a href="/calculators/" class="text-ink-muted hover:text-accent transition-colors">
          All calculators
        </a>
      </nav>

      <div class="ml-auto flex items-center gap-2">
        <span
          class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent"
        >
          <span class="size-1.5 rounded-full bg-accent"></span>
          100% free
        </span>

        {/*
          Below `md` the nav above is display:none, which left the header with a
          logo and nothing else — every category and the full index were
          unreachable without scrolling past the whole calculator to the footer.

          A <details> rather than a scripted menu: it needs no JavaScript, so it
          works before the island loads and with scripting off entirely, and it
          keeps `_headers` free of the inline-script allowance a click handler
          would want. <summary> is already a button to assistive tech and to the
          keyboard, so there is no ARIA to hand-roll.

          The trade-off is that tapping outside does not close it — closing means
          tapping the control again. That is the price of not shipping a script,
          and it is the same bargain the rest of this theme makes.
        */}
        <details class="relative md:hidden">
          <summary
            class="grid size-9 cursor-pointer list-none place-items-center rounded-lg border border-border-subtle text-ink-muted [&::-webkit-details-marker]:hidden"
            aria-label="Menu"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M2.5 5h13M2.5 9h13M2.5 13h13"></path>
            </svg>
          </summary>

          <nav
            aria-label="Categories"
            class="absolute right-0 top-full mt-2 w-56 rounded-card border border-border-subtle bg-surface p-2 text-sm shadow-lg"
          >
            {
              categories.map((category) => (
                <a
                  href={`${category.href}/`}
                  class="block rounded-lg px-3 py-2 text-ink-muted transition-colors hover:bg-surface-sunken hover:text-accent"
                >
                  {category.name}
                </a>
              ))
            }
            <a
              href="/calculators/"
              class="block rounded-lg px-3 py-2 text-ink-muted transition-colors hover:bg-surface-sunken hover:text-accent"
            >
              All calculators
            </a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main class="flex-1">
    {
      breadcrumbs && breadcrumbs.length > 0 && (
        <div class="mx-auto max-w-6xl px-4 pt-6">
          <Breadcrumbs items={breadcrumbs} />
        </div>
      )
    }
    <slot />
  </main>

  <footer class="mt-16 border-t border-border-subtle bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 text-sm">
      <div>
        <p class="font-semibold text-ink">{SITE_NAME}</p>
        <p class="mt-2 text-ink-muted leading-relaxed">
          Every calculation runs in your browser. Nothing is sent anywhere.
        </p>
      </div>
      {
        categories.map((category) => (
          <div>
            <p class="font-medium text-ink">{category.name}</p>
            <a
              href={`${category.href}/`}
              class="mt-2 inline-block text-ink-muted hover:text-accent transition-colors"
            >
              Browse {category.name.toLowerCase()}
            </a>
          </div>
        ))
      }
    </div>
    <div class="border-t border-border-subtle">
      <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-ink-muted">
        &copy; {new Date().getFullYear()} {SITE_NAME}
      </p>
    </div>
  </footer>
</div>
