---
import type { RelatedGridProps } from '../contract'

type Props = RelatedGridProps
const { links } = Astro.props
---

{
  links.length > 0 && (
    <section class="mt-12">
      <h2 class="text-lg font-semibold text-ink">Related calculators</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-card border border-border-subtle bg-surface px-4 py-3 text-sm text-ink hover:border-accent"
            >
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
