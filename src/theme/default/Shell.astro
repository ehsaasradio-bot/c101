---
import type { ShellProps } from '../contract'
import Breadcrumbs from './Breadcrumbs.astro'
import { SITE_NAME } from '../../lib/site'
import { categories } from '../../lib/categories'

type Props = ShellProps
const { breadcrumbs } = Astro.props
---

<div class="min-h-screen flex flex-col">
  <header class="bg-surface border-b border-border-subtle">
    <div class="mx-auto max-w-5xl px-4 py-4 flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href="/" class="font-semibold text-ink tracking-tight">{SITE_NAME}</a>
      <nav aria-label="Categories" class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {
          categories.map((category) => (
            <a href={`${category.href}/`} class="text-ink-muted hover:text-accent">
              {category.name}
            </a>
          ))
        }
      </nav>
      <a href="/calculators/" class="ml-auto text-sm text-ink-muted hover:text-accent">
        All calculators
      </a>
    </div>
  </header>

  <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
    {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
    <slot />
  </main>

  <footer class="bg-surface border-t border-border-subtle">
    <div
      class="mx-auto max-w-5xl px-4 py-6 text-sm text-ink-muted flex flex-wrap gap-x-6 gap-y-2 justify-between"
    >
      <p>&copy; {new Date().getFullYear()} {SITE_NAME}</p>
      <p>Every calculation runs in your browser. Nothing is sent anywhere.</p>
    </div>
  </footer>
</div>
