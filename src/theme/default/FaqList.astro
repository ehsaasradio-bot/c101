---
import type { FaqListProps } from '../contract'

type Props = FaqListProps
const { faqs } = Astro.props
---

{
  faqs.length > 0 && (
    <section class="mt-12">
      <h2 class="text-lg font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-4 space-y-3">
        {faqs.map((faq) => (
          <details class="rounded-card border border-border-subtle bg-surface px-4 py-3">
            <summary class="cursor-pointer text-sm font-medium text-ink">{faq.q}</summary>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
