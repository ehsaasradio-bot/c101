---
import type { ResultCardProps } from '../contract'
import Meter from './Meter.astro'

type Props = ResultCardProps
const { result, resultLabel, scale } = Astro.props

const isRule = (step: (typeof result.steps)[number]): step is { rule: true } => 'rule' in step
---

{/* Rendered at build time with the calculator's defaults, so it is correct and
    visible before any JavaScript loads — and stays correct with JS disabled.
    The island only repaints it after the first input event. */}
<div
  data-calc-result
  class="rounded-card border border-border-subtle bg-surface p-5 border-l-4 border-l-band"
>
  <p data-calc-out="primary-label" class="text-sm text-ink-muted">{resultLabel}</p>
  {/* `data-animate="count"` is the theme opting in — the island only tweens
      when it finds this. A theme that wants an instant swap simply omits it. */}
  <p
    data-calc-out="primary"
    data-animate="count"
    class="mt-1 text-3xl font-semibold tabular-nums text-ink"
  >
    {result.primary.text}
  </p>

  {scale && <Meter scale={scale} percent={result.scalePercent} band={result.band} bandLabel={result.bandLabel} />}

  <dl data-calc-list="stats" class="mt-5 grid gap-2 sm:grid-cols-2">
    {
      result.stats.map((stat) => (
        <div class="rounded-control bg-surface-sunken px-3 py-2">
          <dt data-slot="label" class="text-xs text-ink-muted">
            {stat.label}
          </dt>
          <dd data-slot="value" class="text-sm font-medium tabular-nums text-ink">
            {stat.text}
          </dd>
        </div>
      ))
    }
  </dl>

  <ul data-calc-list="notes" class="mt-4 space-y-1">
    {
      result.notes.map((note) => (
        <li data-slot="value" class="text-xs text-ink-muted">
          {note}
        </li>
      ))
    }
  </ul>
</div>

<p
  data-calc-error
  hidden
  role="alert"
  class="mt-3 rounded-control px-3 py-2 text-sm text-[var(--c-band-critical)] bg-surface border border-[var(--c-band-critical)]"
>
</p>

{
  result.steps.length > 0 && (
    <details class="mt-4 rounded-card border border-border-subtle bg-surface">
      <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-ink">
        Show the working
      </summary>
      <dl data-calc-list="steps" class="px-5 pb-4 text-sm">
        {result.steps.map((step) =>
          isRule(step) ? (
            <hr class="my-2 border-border-subtle" />
          ) : (
            <div class="flex justify-between gap-4 py-1">
              <dt data-slot="label" class="text-ink-muted">
                {step.label}
              </dt>
              <dd data-slot="value" class="tabular-nums text-ink">
                {step.text}
              </dd>
            </div>
          ),
        )}
      </dl>
    </details>
  )
}

{/* The island clones these instead of building markup in JavaScript. Restyle a
    row here and the island needs no change — see src/islands/CONTRACT.md. */}
<template data-calc-row="stat">
  <div class="rounded-control bg-surface-sunken px-3 py-2">
    <dt data-slot="label" class="text-xs text-ink-muted"></dt>
    <dd data-slot="value" class="text-sm font-medium tabular-nums text-ink"></dd>
  </div>
</template>

<template data-calc-row="step">
  <div class="flex justify-between gap-4 py-1">
    <dt data-slot="label" class="text-ink-muted"></dt>
    <dd data-slot="value" class="tabular-nums text-ink"></dd>
  </div>
</template>

<template data-calc-row="rule">
  <hr class="my-2 border-border-subtle" />
</template>

<template data-calc-row="note">
  <li data-slot="value" class="text-xs text-ink-muted"></li>
</template>
