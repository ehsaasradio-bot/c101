---
import BaseLayout from '../layouts/BaseLayout.astro'
import Seo from '../seo/Seo.astro'
import { CategoryGrid, CalculatorGrid } from '../theme'
import { byCategory, calculators } from '../calculators'
import { categories } from '../lib/categories'
import { calculatorHref } from '../lib/view'
import { SITE_DESCRIPTION, SITE_NAME } from '../lib/site'

const withCounts = categories.map((category) => ({
  ...category,
  count: byCategory.get(category.id)?.length ?? 0,
}))

const popular = calculators
  .filter((calc) => (calc.priority ?? 0) >= 0.85)
  .map((calc) => ({
    slug: calc.slug,
    title: calc.title,
    href: calculatorHref(calc.slug),
    description: calc.description,
  }))
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION}>
  <Seo slot="head" title={`${SITE_NAME} — Free Online Calculators`} description={SITE_DESCRIPTION} />

  <h1 class="text-3xl font-semibold tracking-tight text-ink">Free online calculators</h1>
  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-muted">{SITE_DESCRIPTION}</p>

  <section class="mt-10">
    <h2 class="sr-only">Categories</h2>
    <CategoryGrid categories={withCounts} />
  </section>

  {
    popular.length > 0 && (
      <section class="mt-12">
        <h2 class="text-lg font-semibold text-ink">Most used</h2>
        <div class="mt-4">
          <CalculatorGrid items={popular} />
        </div>
      </section>
    )
  }
</BaseLayout>
