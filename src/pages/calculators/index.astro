---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Seo from '../../seo/Seo.astro'
import { CalculatorGrid } from '../../theme'
import { byCategory } from '../../calculators'
import { categories } from '../../lib/categories'
import { calculatorHref } from '../../lib/view'
import { breadcrumbList } from '../../seo/jsonld'

const groups = categories
  .map((category) => ({
    category,
    items: (byCategory.get(category.id) ?? []).map((calc) => ({
      slug: calc.slug,
      title: calc.title,
      href: calculatorHref(calc.slug),
      description: calc.description,
    })),
  }))
  .filter((group) => group.items.length > 0)

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'All calculators', href: '/calculators/' },
]
const description = 'Every calculator on the site, grouped by category. Free, instant, no sign-up.'
---

<BaseLayout title="All calculators" description={description} breadcrumbs={breadcrumbs}>
  <Seo slot="head" title="All Calculators" description={description} schemas={[breadcrumbList(breadcrumbs)]} />

  {/*
    Shell wraps its breadcrumb in this container but not its <slot />, so a page
    whose content is not itself wrapped runs edge to edge. CalculatorPage and
    Hero carry their own; a plain page like this one has to say so.
  */}
  <div class="mx-auto max-w-6xl px-4">
    <h1 class="text-2xl font-semibold tracking-tight text-ink">All calculators</h1>

    {
      groups.map((group) => (
        <section class="mt-8">
          <h2 class="text-lg font-semibold text-ink">
            <a href={`${group.category.href}/`} class="hover:text-accent">
              {group.category.name}
            </a>
          </h2>
          <div class="mt-3">
            <CalculatorGrid items={group.items} />
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
