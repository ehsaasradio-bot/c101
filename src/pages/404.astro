---
import BaseLayout from '../layouts/BaseLayout.astro'
import Seo from '../seo/Seo.astro'
import { CalculatorGrid } from '../theme'
import { calculators } from '../calculators'
import { categories } from '../lib/categories'
import { calculatorHref } from '../lib/view'

/*
 * Cloudflare Pages serves this file's build output, `dist/404.html`, with a real
 * 404 status for any path that does not match a generated page. Without it, an
 * unmatched URL fell back to the homepage with HTTP 200 — a soft 404, which is
 * the worst outcome for a site whose traffic is search: crawlers index every
 * mistyped or stale URL as a duplicate of the front page.
 *
 * There is no `getStaticPaths` here and no dynamic data, so this cannot drift as
 * calculators are added; the suggestions below come from the registry.
 */
const suggestions = ['mortgage-calculator', 'bmi-calculator', 'percentage-calculator', 'tip-calculator']
  .map((slug) => calculators.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .map((calc) => ({
    slug: calc.slug,
    title: calc.title,
    href: calculatorHref(calc.slug),
    description: calc.description,
  }))

const description = 'That page does not exist. Browse every calculator by category instead.'
---

<BaseLayout title="Page not found" description={description}>
  {/* Never indexable, whatever the site-wide switch says. The 404 status is the
      signal crawlers actually act on, but a page that returns 404 should not
      also be advertising itself as indexable. */}
  <Seo slot="head" title="Page Not Found" description={description} noindex />

  {/* Shell wraps its breadcrumb but not its <slot />, so a plain page has to
      carry its own container or it renders edge to edge. */}
  <div class="mx-auto max-w-6xl px-4 pt-10">
    <p class="text-sm font-medium text-accent">404</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-ink">This page does not exist</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-muted">
      The address may be mistyped, or the calculator may have been renamed. Everything on the site is
      listed under <a href="/calculators/" class="text-accent hover:underline">all calculators</a>, or
      pick a category below.
    </p>

    <nav aria-label="Categories" class="mt-6 flex flex-wrap gap-2">
      {
        categories.map((category) => (
          <a
            href={`${category.href}/`}
            class="rounded-full border border-border-subtle px-3 py-1.5 text-sm text-ink-muted transition-colors hover:border-accent hover:text-accent"
          >
            {category.name}
          </a>
        ))
      }
    </nav>

    <section class="mt-10" aria-label="Popular calculators">
      <h2 class="text-lg font-semibold text-ink">Most used</h2>
      <div class="mt-3">
        <CalculatorGrid items={suggestions} />
      </div>
    </section>
  </div>
</BaseLayout>
